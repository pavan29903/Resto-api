# ---------------------------------------------------------------------------
# MenuSnap Phase 0 pipeline configuration. Copy to `.env` and fill in.
#
# Defaults are the FREE options: Gemini free tier for reading menus, and
# Pollinations (free FLUX) for dish images. Validate on real menus first —
# escalate to paid models only where accuracy actually demands it.
# ---------------------------------------------------------------------------

# === 1. Menu extraction (photo -> structured menu) =========================
# Provider: "gemini" (default, FREE tier) or "claude" (paid, highest accuracy).
EXTRACTION_PROVIDER=gemini

# --- Gemini path (default) ---
# FREE: 1,500 requests/day, 15/min, no credit card.
# Get a key in 30 seconds at https://aistudio.google.com/apikey
# NOTE: on the free tier Google may use your data to improve their products.
#       Fine for testing with sample menus; revisit before real customer data.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Claude path (escalation, if Gemini accuracy isn't good enough) ---
# Paid: ~$0.13 per menu on Opus. Leave blank unless EXTRACTION_PROVIDER=claude.
# Needs: uv sync --extra gemini  is NOT required for this path.
ANTHROPIC_API_KEY=
# claude-opus-4-8 (best accuracy) | claude-sonnet-5 | claude-haiku-4-5 (cheapest)
EXTRACTION_MODEL=claude-opus-4-8

# === 2. Dish images ========================================================
# Provider: "pexels" (default, real licensed photos) | "pollinations" (AI, free)
#         | "placeholder" (offline card) | "fal" | "replicate" (paid AI).
#
# A real photo of the dish beats an AI guess, so we search Pexels first and only
# generate when there's no match. Chain: IMAGE_PROVIDER -> IMAGE_FALLBACK -> placeholder.
IMAGE_PROVIDER=pexels
IMAGE_FALLBACK=pollinations

# --- Pexels (default) --- FREE: 200 requests/hour, 20,000/month.
# Content is licensed for commercial use with NO attribution required, which is
# what makes it safe on a paying restaurant's menu. Scraped Google Images are NOT.
# Get a key in a minute at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Pollinations (AI fallback) --- no key, no signup, free. Rate-limited to
# roughly one image every 15s, so it's slow. Set IMAGE_FALLBACK=placeholder to skip it.
POLLINATIONS_MODEL=flux

# --- Paid image providers (optional) ---
# fal.ai       -> uv sync --extra fal        | key: https://fal.ai
FAL_API_KEY=
# Replicate    -> uv sync --extra replicate
REPLICATE_API_TOKEN=
#   fal:       fal-ai/flux/schnell (fast+cheap) | fal-ai/flux/dev (higher quality)
#   replicate: black-forest-labs/flux-schnell
IMAGE_MODEL=fal-ai/flux/schnell

# === 3. Database + Supabase ================================================
# Create a free project at https://supabase.com  (note: a free project PAUSES
# after 7 days with no traffic — move to Pro before a real cafe depends on it).
#
# DATABASE_URL: Supabase dashboard -> Settings -> Database -> Connection string
#   -> URI. Use the "Session pooler" URI. Replace [YOUR-PASSWORD] with the
#   database password you set when creating the project.
DATABASE_URL=

# Settings -> API. The anon key is public (it ships to the browser); the
# service key and JWT secret are secrets and must never reach the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=dish-images

# === 4. Presentation =======================================================
# Root domain for published menus. Each restaurant gets <slug>.<MENU_DOMAIN>,
# e.g. bluetokai.menusnap.in. Leave blank in local dev to use path URLs
# (localhost:3000/r/<slug>).
MENU_DOMAIN=

# Fallback currency symbol if the menu's detected currency isn't in our map.
CURRENCY_SYMBOL=₹
# Where the generated menu will be hosted. Used to build the QR target URL.
# For a quick phone test: run `python -m http.server` in the output folder and
# use your machine's LAN IP, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000
# Optional: owner's WhatsApp in international format (no +, no spaces),
# e.g. 919876543210. If set, the menu page shows an "Order on WhatsApp" button —
# a cheap way to test ordering intent before the real ordering backend exists.
OWNER_WHATSAPP=

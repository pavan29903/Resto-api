<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ restaurant_name }} — Menu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { -webkit-tap-highlight-color: transparent; }
    .veg-dot, .nonveg-dot { width: 14px; height: 14px; border-width: 2px; }
  </style>
</head>
<body class="bg-stone-50 text-stone-900">
  <header class="bg-white border-b border-stone-200 sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-4 py-4">
      <h1 class="text-2xl font-bold tracking-tight">{{ restaurant_name }}</h1>
      <p class="text-sm text-stone-500">Digital menu</p>
    </div>
  </header>

  <main class="max-w-2xl mx-auto px-4 py-6 space-y-10 pb-28">
    {% for section in sections %}
    <section>
      <h2 class="text-lg font-semibold uppercase tracking-wide text-amber-700 mb-4">
        {{ section.name }}
      </h2>
      <div class="space-y-4">
        {% for item in section['items'] %}
        <article class="flex gap-4 bg-white rounded-2xl border border-stone-200 p-3">
          {% if item.image %}
          <img src="{{ item.image }}" alt="{{ item.name }}"
               class="w-24 h-24 rounded-xl object-cover flex-none" loading="lazy" />
          {% endif %}
          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-semibold leading-snug flex items-center gap-2">
                {% if item.is_vegetarian is true %}
                <span class="veg-dot inline-block rounded-sm border-green-600" title="Veg"></span>
                {% elif item.is_vegetarian is false %}
                <span class="nonveg-dot inline-block rounded-sm border-red-600" title="Non-veg"></span>
                {% endif %}
                <span>{{ item.name }}</span>
              </h3>
              {% if item.price %}
              <span class="font-semibold whitespace-nowrap">{{ item.price }}</span>
              {% endif %}
            </div>
            {% if item.description %}
            <p class="text-sm text-stone-500 mt-1">{{ item.description }}</p>
            {% endif %}
            {% if item.spice_level %}
            <p class="text-xs text-red-500 mt-1 capitalize">{{ item.spice_level }}</p>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endfor %}

    <p class="text-center text-xs text-stone-400 pt-4">
      Dish photos are illustrative. Made with MenuSnap.
    </p>
  </main>

  {% if whatsapp %}
  <a href="https://wa.me/{{ whatsapp }}?text=Hi%2C%20I%27d%20like%20to%20order%20from%20{{ restaurant_name | urlencode }}"
     class="fixed bottom-5 inset-x-0 mx-auto w-max bg-green-600 text-white font-semibold
            px-6 py-3 rounded-full shadow-lg flex items-center gap-2 z-20">
    Order on WhatsApp
  </a>
  {% endif %}
</body>
</html>
